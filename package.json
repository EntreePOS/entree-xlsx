{
  "name": "@entree_pos/xlsx",
  "version": "0.4.1",
  "description": "A zero-dependency modern JavaScript API for lossless XLSX/XLSM editing, charts, pivot tables, and Office password encryption.",
  "keywords": [
    "xlsx",
    "excel",
    "spreadsheet",
    "workbook",
    "worksheet",
    "entreepos"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EntreePOS/entree-xlsx.git"
  },
  "homepage": "https://entreepos.github.io/entree-xlsx/",
  "bugs": {
    "url": "https://github.com/EntreePOS/entree-xlsx/issues"
  },
  "license": "MIT",
  "author": "Entree POS",
  "type": "module",
  "main": "./src/index.js",
  "exports": "./src/index.js",
  "bin": {
    "entree-xlsx": "./src/cli.js"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test/run-tests.js",
    "showcase": "node test/generate-examples.js",
    "tutorial:sync": "node site/examples/sync-code-snippets.js",
    "tutorial:check": "node site/examples/sync-code-snippets.js --check",
    "tutorial:generate": "node site/examples/generate-all.js",
    "tutorial:verify": "node site/examples/verify-all.js",
    "check": "npm test && npm audit --omit=dev && npm pack --dry-run",
    "prepublishOnly": "npm run check"
  }
}
